# Demo mode works without credentials. Live mode uses this server-side key only.
OPENAI_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=demo-codex
PROVIDER_TIMEOUT_SECONDS=60
DATABASE_URL=sqlite://data/drift.db?mode=rwc
ANALYZER_URL=http://127.0.0.1:8001
API_BIND=127.0.0.1:8080
# Set to an OTLP/HTTP base URL (without /v1/traces) to export traces.
OTEL_EXPORTER_OTLP_ENDPOINT=

